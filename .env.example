# Credbound is a library; the host service reads these. The names below match
# examples/minimal (see examples/minimal/main.go), which hex-decodes them.
# Generate the 32-byte secrets with, for example: openssl rand -hex 32

# Root key (exactly 32 bytes, hex-encoded) and the two peppers (at least 32
# bytes, hex). See Config.SecretKey, Config.PATPepper, Config.RecoveryPepper.
CREDBOUND_SECRET_KEY=
CREDBOUND_PAT_PEPPER=
CREDBOUND_RECOVERY_PEPPER=

# PostgreSQL DSN for the bundled example store. The example opens one pgx pool
# and hands the store both views of it. Empty falls back to the example default
# (postgres://localhost:5432/credbound?sslmode=disable).
CREDBOUND_POSTGRES_DSN=postgres://localhost:5432/credbound?sslmode=disable

# First-run bootstrap identity created by the example.
CREDBOUND_BOOTSTRAP_EMAIL=root@example.com
CREDBOUND_BOOTSTRAP_PASSWORD=
